rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'; }
  match /roles/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role == 'user') || (admin() && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role in ['user', 'agent', 'admin']);
   allow update: if admin() && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role in ['user', 'agent', 'admin'];
   allow delete: if admin() && request.auth.uid != uid;
  }
  match /saved/{uid}/properties/{propertyId} {
   allow read, delete: if signedIn() && request.auth.uid == uid;
   allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['propertyId']) && request.resource.data.propertyId == propertyId;
  }
  match /properties/{id} {
   allow read: if resource.data.status == 'published' || (signedIn() && (resource.data.ownerId == request.auth.uid || admin()));
   allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'pending';
   allow update: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.status == 'pending');
   allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || admin());
  }
  match /{document=**} { allow read, write: if false; }
 }
}
